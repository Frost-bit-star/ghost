#!/data/data/com.termux/files/usr/bin/bash
# Ghost - opencode-style multi-agent AI assistant for Termux (PURE BASH)
# Developer: Frost-bit-star (https://github.com/Frost-bit-star)
#
# Backend: connects to a running `opencode serve` server (the exact HTTP API
# opencode uses). Agents map 1:1 to opencode's real agents:
#   build, plan (primary) | general, explore (subagent)
# If the opencode server is unreachable, falls back to any OpenAI-compatible
# provider configured via /config.
#
# Requires only: bash, curl OR wget, jq. No python, no node.

# =========================
# CONFIGURATION
# =========================
MEMORY_FILE="$HOME/.ghost_memory"
CONFIG_DIR="${GHOST_CONFIG_DIR:-$HOME/.config/ghost}"
CONFIG_FILE="$CONFIG_DIR/config"
DEVICE_NAME=$(uname -n)
PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"

# opencode server (default local). Point GHOST_OC_URL at a desktop running
# `opencode serve` for Termux-over-LAN use.
OC_URL="${GHOST_OC_URL:-http://127.0.0.1:4096}"
OC_USER="${GHOST_OC_USER:-}"
OC_PASS="${GHOST_OC_PASS:-}"

# OpenAI-compatible fallback backend
AI_API="${GHOST_AI_URL:-}"
API_KEY="${GHOST_API_KEY:-}"
MODEL="${GHOST_MODEL:-}"
GHOST_PROVIDER="openai"

# Colors
R="\033[1;31m"
C="\033[1;36m"
Y="\033[1;33m"
G="\033[1;32m"
P="\033[1;35m"
B="\033[1;34m"
W="\033[0m"
BOLD="\033[1m"
DIM="\033[2m"

# =========================
# AGENTS (map to opencode server agents)
# =========================
# PRIMARY: build (full access) | plan (read-only)
# SUBAGENT: general | explore | scout(->general+research prompt)
PRIMARY_AGENTS=(build plan)
ACTIVE_AGENT="build"

# Shared response protocol every agent must follow.
agent_protocol() {
    echo "You are part of the Ghost agent TEAM: build (execute), plan (strategy, read-only), general (utility), explore (recon), scout (research). Teammates can take over for you if you are unavailable. Use HANDOFF to delegate a sub-task to the teammate best suited for it.
Always start with a REASONING: section (your brief thinking). Then use EXACTLY one of these:
[ask]  when you need info from the user:
QUESTION:
<the question>

OPTIONS:
1. <possible answer>
2. <possible answer>
(OPTIONS is optional; the user will pick a number or type their own answer)
[act]  when you are ready to run Termux commands: put a line containing ONLY '---', then the raw bash commands, one per line
[delegate]  when a specialist agent should handle a sub-task for you: a line containing ONLY 'HANDOFF:', the next line the agent name (explore/scout/plan/general), then the sub-task on the lines after. The specialist's result will be returned to you so you can continue.
[answer]  a plain-text reply with no QUESTION and no '---' line
No markdown, no backticks, no color codes, no emojis. Do NOT call tools or run anything yourself. Task:"
}

# Termux-specific environment knowledge (Termux is NOT full Linux).
termux_context() {
    echo "TERMUX CONTEXT (CRITICAL - this is NOT full Linux):
- Termux is a Linux userspace on Android: restricted, no root by default, no systemd.
- Package manager is 'pkg install <tool>' (or apt). NEVER dnf/yum/pacman/apk. There is NO sudo - operate as the normal user.
- Root prefix is \$PREFIX (usually /data/data/com.termux/files/usr); home is \$HOME under that tree.
- Android storage is sandboxed: shared/internal storage is only visible after 'termux-setup-storage', then at ~/storage/shared etc.
- Many Linux paths do NOT exist or are read-only: /root, /sys, most of /proc, /etc/services, /var/log, systemctl, journalctl.
- Networking works normally (curl, ssh, ping, nmap via pkg). GUI/desktop and hardware control are not available.
- Recommend only commands that actually work in this Termux environment."
}

agent_prompt() {
    local agent="$1" p ctx
    p=$(agent_protocol)
    ctx=$(termux_context)
    case "$agent" in
        build)
            echo "You are the Build agent of Ghost for Termux. Expert in Termux, Linux and ethical hacking (authorized penetration testing only). You may ask the user for clarification before acting. $p $ctx" ;;
        plan)
            echo "You are the Plan agent of Ghost for Termux (read-only). NEVER execute anything. Analyse the task and return a numbered step-by-step plan (max 8 steps): which Termux commands would run, in what order, and why. You may ask for clarification first. $p $ctx" ;;
        general)
            echo "You are the General subagent of Ghost for Termux. Handle complex multi-step Termux tasks. You may ask the user for clarification before acting. $p $ctx" ;;
        explore)
            echo "You are the Explore subagent of Ghost for Termux (read-only recon). First reason about what to look for. You may ask what to investigate. Then act with ONLY read-only Termux commands: pkg list, ls, find, cat, ip/ifconfig, netstat/ss, route, nmap scans. $p $ctx" ;;
        scout)
            echo "You are the Scout subagent of Ghost for Termux (research). Research tools, CVEs, exploit-db entries, documentation. Reply with a short factual report, then when needed a line with ONLY '---' then up to 3 relevant Termux commands (curl/searchsploit/apt) to fetch or verify the info. $p $ctx" ;;
        *)
            echo "You are an expert Termux and ethical hacking assistant. You may ask the user for clarification before acting. $p $ctx" ;;
    esac
}

agent_map() {
    # ghost agent -> opencode server agent id
    case "$1" in
        build|plan|general|explore) echo "$1" ;;
        scout) echo "general" ;;  # opencode 1.18 has no scout; use general + research prompt
        *) echo "build" ;;
    esac
}

list_agents() {
    echo -e "${C}┌────────────────── AGENTS ──────────────────┐${W}"
    echo -e "${C}│${W} ${G}PRIMARY${W} (switch with ${Y}TAB${W})              ${C}│${W}"
    echo -e "${C}│${W}   ${B}build${W}  full access · install/config/run     ${C}│${W}"
    echo -e "${C}│${W}   ${B}plan${W}   read-only · numbered plan, no exec   ${C}│${W}"
    echo -e "${C}│${W} ${G}SUBAGENTS${W} (invoke with ${Y}@name${W})          ${C}│${W}"
    echo -e "${C}│${W}   ${B}general${W} multi-step tasks                    ${C}│${W}"
    echo -e "${C}│${W}   ${B}explore${W} read-only recon / exploration       ${C}│${W}"
    echo -e "${C}│${W}   ${B}scout${W}   research CVEs / docs / exploit-db   ${C}│${W}"
    echo -e "${C}│${W} ${G}HIDDEN${W} (auto) title · summary · compaction    ${C}│${W}"
    echo -e "${C}│${W} ${G}TEAM${W}   /team · handoff · auto-failover      ${C}│${W}"
    echo -e "${C}└────────────────────────────────────────────┘${W}"
}

# =========================
# CORE UI
# =========================

type_effect() {
    local text="$1"
    for (( i=0; i<${#text}; i++ )); do
        echo -en "${text:$i:1}"
        sleep 0.005
    done
    echo
}

loading_anim() {
    local pid=$1
    local spinstr='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
    echo -en "${P} GHOST ANALYZING "
    while [ -d /proc/$pid ]; do
        local temp=${spinstr#?}
        printf " %c " "$spinstr"
        local spinstr=$temp${spinstr%"$temp"}
        sleep 0.1
        printf "\b\b\b"
    done
    printf " ${G}[DONE]${W}\n"
}

